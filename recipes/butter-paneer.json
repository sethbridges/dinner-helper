{
  "id": "butter-paneer",
  "title": "Butter paneer",
  "serves": "4",
  "time": "35 minutes",
  "sourceName": "Serious Eats",
  "sourceUrl": "https://www.seriouseats.com/easy-butter-paneer-spinach-recipe",
  "ingredients": [
    "1 lb paneer, cubed",
    "3 tbsp butter",
    "1 onion, sliced",
    "1 inch ginger, chopped",
    "1 jalapeño or pinch chili",
    "1 28-oz can whole tomatoes",
    "1/2 tsp cinnamon",
    "1 tbsp honey or sugar",
    "1/3 cup cream",
    "Salt",
    "Spinach optional",
    "Rice and naan"
  ],
  "steps": [
    "Cook onion, ginger, and chili in butter until soft.",
    "Add tomatoes, cinnamon, and honey. Simmer 12 minutes. Blend until smooth.",
    "Return to pot with cream and salt. Fold in paneer (and spinach) to warm through.",
    "Serve with rice and naan."
  ]
}
